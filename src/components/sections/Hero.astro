---
import VideoBackground from "../VideoBackground.astro";

interface Action {
    label: string;
    href: string;
    external?: boolean;
    secondary?: boolean;
}
interface Props {
    heading?: string;
    intro?: string;
    actions?: Action[];
    compact?: boolean;
}
const { heading, intro, actions = [], compact = false } = Astro.props;
---

<section class:list={["hero", { compact }]}>
    <VideoBackground />
    <div class="hero-content fade-in-up">
        {
            heading ? (
                <h1>
                    <Fragment set:html={heading} />
                </h1>
            ) : (
                <h1>
                    <span class="hero-highlight">TuitionBase</span> offers expert <span class="hero-highlight">tuition in London</span> to
                    students of <span class="hero-highlight">5-18 </span>
                    years within a safe and <span class="hero-highlight">secure environment</span>
                </h1>
            )
        }
        <p>
            {
                intro ??
                    "OFSTED-registered Maths, English, Biology, Chemistry, Physics and 11+ tuition in small groups at centres in Enfield, Edmonton and Forest Gate"
            }
        </p>
        {
            actions.length > 0 && (
                <div class="hero-actions">
                    {actions.map((a) => (
                        <a
                            class:list={["hero-btn", { secondary: a.secondary }]}
                            href={a.href}
                            target={a.external ? "_blank" : undefined}
                            rel={a.external ? "noopener noreferrer" : undefined}
                        >
                            {a.label}
                        </a>
                    ))}
                </div>
            )
        }
    </div>
</section>
<style lang="scss">
    /* Hero Section */
    .hero {
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 128px 32px 64px;
        height: 100svh;
        color: white;
        text-align: center;
        overflow: hidden;
    }

    .hero.compact {
        height: auto;
        min-height: 70svh;
    }

    .hero-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 16px;
    }

    .hero-btn {
        padding: 14px 28px;
        border-radius: 8px;
        background: #0bb2f0;
        color: white;
        font-weight: 600;
        text-decoration: none;
        border: 2px solid #0bb2f0;

        &.secondary {
            background: transparent;
            border-color: white;
        }
    }

    .hero-content {
        max-width: 900px;
        margin: 0 auto;
        position: relative;
        z-index: 2;
    }

    .hero h1 {
        font-size: 48px;
        margin-bottom: 32px;
    }

    .hero :global(.hero-highlight) {
        color: #0bb2f0;
    }

    .hero p {
        font-size: 21px;
        margin-bottom: 32px;
        color: #f3f3f3;
        text-wrap: balance;
        text-wrap: pretty;
    }

    .credentials-image {
        width: 90%;
        max-width: 420px;
        display: block;
        margin: 32px auto 0 0;
    }

    @media (max-width: 768px) {
        .hero h1 {
            font-size: 32px;
        }

        .hero p {
            font-size: 18px;
        }

        .credentials-image {
            margin: 22px auto 0;
            width: 98%;
        }
    }
</style>
