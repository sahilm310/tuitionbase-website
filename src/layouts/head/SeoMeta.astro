---
import { websiteUrl } from "../../config/constants";

const {
    title = "Tuition in London | Maths, English, Science & 11+ | TuitionBase",
    description = "OFSTED-registered tuition in London for ages 5-18. Small-group Maths, English, Science and 11+ tuition from KS1 to A Level at centres in Enfield, Edmonton and Forest Gate.",
    path = "/",
} = Astro.props;
const pageUrl = `${websiteUrl}${path}`;
---

<meta name="description" content={description} />
<meta name="title" content={title} />
<meta
    name="Keywords"
    content="tuition, tutors, tutors in london, english tuition, maths tuition, science tuition, tuition in london, tuition in enfield, tuition in edmonton, tuition in forest gate, 11+ tuition london, gcse tuition london, tuition centre, gcse, london"
/>

<meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
<link rel="alternate" type="text/plain" href={`${websiteUrl}/llms.txt`} title="LLM summary" />
<meta name="revisit-after" content="3 days" />
<meta name="Reply-to" content="info@tuitionbase.co.uk" />
<meta name="coverage" content="worldwide" />
<meta name="language" content="en-GB" />
<meta name="Classification" content="Tuition classes for A-levels, GCSEs, KS3, KS2 and KS1 with affordable pricing" />
<meta name="Author" content="tuitionbase.co.uk" />

<!-- Facebook Meta Tags -->
<meta property="og:url" content={pageUrl} />
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={`${websiteUrl}/content/images/meta/og_image_630.png`} />
<meta property="og:locale" content="en_GB" />
<meta property="og:site_name" content="TuitionBase" />
<meta property="article:author" content="TuitionBase" />
<meta property="article:publisher" content="TuitionBase" />

<!-- Twitter Meta Tags -->
<meta name="twitter:card" content="summary_large_image" />
<meta property="twitter:domain" content="tuitionbase.co.uk" />
<meta property="twitter:url" content={pageUrl} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={`${websiteUrl}/content/images/meta/og_image_630.png`} />

<meta name="geo.region" content="GB-LND" />
<meta name="geo.placename" content="London" />
<meta name="geo.position" content="51.629444;-0.055889" />
<meta name="ICBM" content="51.629444, -0.055889" />
<meta name="DC.title" content="TuitionBase - London Tuition Centre" />

<!-- Additional Meta Tags -->
<meta name="subject" content="Educational Services" />
<meta name="topic" content="Private Tutoring London" />
<meta name="summary" content="Expert tutoring services across London for all key stages with small group classes and affordable pricing" />
<meta name="category" content="Education" />
<meta name="target" content="students, parents, education" />
<meta name="audience" content="students, parents, educators" />
<meta name="distribution" content="global" />
<meta name="rating" content="general" />
<meta name="HandheldFriendly" content="True" />
<meta name="MobileOptimized" content="320" />

<!-- Language and Canonical Links -->
<link rel="canonical" href={pageUrl} />
<link rel="alternate" hreflang="x-default" href={pageUrl} />
